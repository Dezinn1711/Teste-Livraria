@model BibliotecaApp.Models.Livro

<h2>Excluir Livro</h2>

<div>
    <h4>Tem certeza que deseja excluir o livro abaixo?</h4>

    <dl class="row">
        <dt class="col-sm-2">Título</dt>
        <dd class="col-sm-10">@Model.Titulo</dd>

        <dt class="col-sm-2">Autor</dt>
        <dd class="col-sm-10">@Model.Autor</dd>

        <dt class="col-sm-2">Ano</dt>
        <dd class="col-sm-10">@Model.AnoPublicacao</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>