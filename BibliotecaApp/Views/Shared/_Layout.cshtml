<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Biblioteca</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f4f6f9;
        }

        .navbar {
            background: linear-gradient(90deg, #0d6efd, #0a58ca);
        }

        .card {
            border-radius: 15px;
        }

        .btn-primary {
            border-radius: 10px;
        }

        table {
            border-radius: 10px;
            overflow: hidden;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Livros">
                📚 Biblioteca do Dé
            </a>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

</body>
</html>